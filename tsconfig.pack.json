// Typecheck gate for the beads-dag Archon pack. Dev-only: it lives in the repository, not in the pack
// folder, because the pack is copied to ~/.archon/workflows/ and must carry nothing the runtime cannot use.
//
// Run from the repository root:
//   bun x tsc -p tsconfig.pack.json
//
// The pack's other gate is the repro suite (tests/run-all.ts in the drain folder); this one checks the
// interfaces those scripts happen to exercise, which is how a stale caller stays visible.
//
// `types: ["node"]` is spelled out because a `node:` specifier does not resolve without the node
// declarations in the program. This repository declares @types/node as a dev dependency for this gate;
// nothing else here pulls it in transitively.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": [".archon/workflows/beads-dag/**/*.ts", "pack-globals.d.ts"]
}

// Typecheck gate for the front end's tooling. Dev-only, and it lives here rather than beside the tool for
// the same reason the pack's gate does: what a runner loads must carry nothing the runtime cannot use.
//
// Run from the repository root:
//   bun x tsc -p tsconfig.tools.json
//
// This tool is not the pack — nothing imports the pack's modules, and no runner installs it. It is gated
// because nothing else would notice it rotting: the mock path runs offline and the live path spends real
// requests, so a stale caller can sit there for a long time unnoticed.
//
// `types: ["node"]` is spelled out for the same reason as in tsconfig.pack.json: a `node:` specifier does
// not resolve without the node declarations in the program.
{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["tools/**/*.ts"]
}
